.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--rose);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 24rpx; color: var(--text-light); font-size: 28rpx; }

.section { margin-top: 28rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.version-tag {
  font-size: 24rpx;
  color: var(--text-light);
  font-weight: 400;
  margin-left: 12rpx;
}

/* ===== 操作按钮 ===== */
.actions {
  display: flex;
  margin: 36rpx -8rpx 0;
}
.actions .action-btn {
  flex: 1;
  margin: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text);
}
.action-icon { font-size: 32rpx; margin-right: 8rpx; }

/* ===== 海报区 ===== */
.poster-actions {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}
.poster-actions .share-btn { margin-bottom: 16rpx; }

.share-btn {
  width: 100%;
  height: 96rpx;
}
.save-btn {
  width: 100%;
  background: transparent;
}
