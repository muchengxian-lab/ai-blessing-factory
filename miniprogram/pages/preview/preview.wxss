.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 24rpx; color: var(--text-light); font-size: 28rpx; }

.section { margin-top: 24rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.version-tag {
  font-size: 24rpx;
  color: var(--text-light);
  font-weight: 400;
  margin-left: 12rpx;
}

.actions {
  display: flex;
  margin: 32rpx -8rpx 0;
}
.actions .action-btn { margin: 0 8rpx; }
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text);
}
.action-icon { font-size: 32rpx; }

.poster-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}
.share-btn {
  width: 100%;
  height: 96rpx;
}
.save-btn {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  font-size: 28rpx;
}
