<view class="page-container">
  <!-- Loading state -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载祝福...</text>
  </view>

  <!-- Content -->
  <block wx:else>
    <!-- Blessing Texts -->
    <view class="section">
      <view class="section-title">
        {{holiday}}祝福
        <text class="version-tag">{{currentIndex + 1}}/{{blessings.length}}</text>
      </view>
      <blessing-card
        text="{{currentText}}"
        index="{{currentIndex}}"
        total="{{blessings.length}}"
        bind:prev="onPrev"
        bind:next="onNext"
      />
    </view>

    <!-- Actions -->
    <view class="actions">
      <button class="action-btn" bindtap="onCopy">
        <image class="action-icon" src="/images/icons/action-copy.svg"></image>
        <text>复制文案</text>
      </button>
      <button class="action-btn" bindtap="onRegenerate" loading="{{regenerating}}">
        <image class="action-icon" src="/images/icons/action-refresh.svg"></image>
        <text>换一批</text>
      </button>
    </view>

    <!-- Poster Preview -->
    <view class="section">
      <view class="section-title">
        <image class="section-title-icon" src="/images/icons/section-style.svg"></image>
        <text>祝福海报</text>
      </view>
      <poster-canvas
        id="posterCanvas"
        text="{{currentText}}"
        emoji="{{holidayEmoji}}"
        holiday="{{holiday}}"
        styleId="{{styleId}}"
        bind:save="onPosterSaved"
      />
      <view class="poster-actions">
        <button class="btn-primary share-btn" open-type="share">
          <image class="btn-icon" src="/images/icons/action-share.svg"></image>
          <text>分享给好友</text>
        </button>
        <button class="btn-secondary save-btn" bindtap="onSavePoster">
          <image class="btn-icon" src="/images/icons/action-save.svg"></image>
          <text>保存到相册</text>
        </button>
      </view>
    </view>
  </block>
</view>
