.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.history-list { padding-bottom: 40rpx; }
.history-item { margin-bottom: 16rpx; }
.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.item-emoji { font-size: 40rpx; margin-right: 12rpx; }
.item-info { flex: 1; }
.item-holiday { font-size: 28rpx; font-weight: 600; display: block; }
.item-time { font-size: 24rpx; color: var(--text-light); }
.item-arrow { font-size: 32rpx; color: var(--text-light); }
.item-preview {
  font-size: 26rpx;
  color: var(--text-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
