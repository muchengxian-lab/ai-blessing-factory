.header {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
}
.header-sub {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 12rpx;
}
.countdown {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
}
.countdown-num {
  font-size: 32rpx;
  font-weight: 700;
}

.section {
  margin-top: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.generate-area {
  margin-top: 48rpx;
  padding-bottom: 40rpx;
}
.generate-btn {
  width: 100%;
  height: 104rpx;
  font-size: 36rpx;
  border-radius: 52rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.3);
}
.generate-btn.disabled {
  background: #E0E0E0;
  box-shadow: none;
  color: #B0B0B0;
}
