.header {
  text-align: center;
  padding: 48rpx 0 16rpx;
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--rose);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.header-sub {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 16rpx;
}
.countdown {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, var(--rose-soft), var(--gold-soft));
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--rose);
}
.countdown-num {
  font-size: 34rpx;
  font-weight: 700;
  margin: 0 6rpx;
  color: var(--gold);
}

.section {
  margin-top: 36rpx;
}

.generate-area {
  margin-top: 56rpx;
  padding-bottom: 48rpx;
}
.generate-btn {
  width: 100%;
  height: 108rpx;
  font-size: 36rpx;
  letter-spacing: 4rpx;
  border-radius: 54rpx;
}

/* ===== 装饰元素 ===== */
.header::after {
  content: '';
  display: block;
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--rose), var(--gold));
  border-radius: 2rpx;
  margin: 20rpx auto 0;
}
