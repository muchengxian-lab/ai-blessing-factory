.header {
  text-align: center;
  padding: 56rpx 0 24rpx;
}
.header-star {
  font-size: 36rpx;
  color: var(--gold);
  margin-bottom: 12rpx;
  animation: twinkle 3s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}
.header-title {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(180deg, var(--gold-light) 0%, var(--gold) 60%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.header-sub {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
}
.countdown {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: rgba(240,192,96,0.12);
  border: 1rpx solid rgba(240,192,96,0.25);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-light);
}
.countdown-holiday { color: var(--gold); }
.countdown-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gold);
  margin: 0 6rpx;
}

.section { margin-top: 36rpx; }

.generate-area { margin-top: 56rpx; padding-bottom: 48rpx; }
.generate-btn {
  width: 100%;
  height: 108rpx;
  font-size: 36rpx;
  letter-spacing: 4rpx;
  border-radius: 54rpx;
  padding: 0 48rpx;
  overflow: hidden;
  line-height: 1;
}
.generate-btn-loading {
  opacity: 0.92;
  font-size: 30rpx;
  letter-spacing: 1rpx;
}
.generate-content {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  width: 100%;
  height: 100%;
}
.generate-text {
  display: block;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1;
}
.generate-spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(26,16,37,0.25);
  border-top-color: #1A1025;
  flex-shrink: 0;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
