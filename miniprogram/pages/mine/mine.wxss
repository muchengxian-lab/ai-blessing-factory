.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}
.menu-list { margin-bottom: 48rpx; }
.menu-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
}
.share-item {
  border: none;
  text-align: left;
  width: 100%;
  box-sizing: border-box;
}
.share-item::after { border: none; }
.menu-icon { font-size: 36rpx; margin-right: 16rpx; }
.menu-label { flex: 1; font-weight: 500; }
.menu-value { font-size: 26rpx; color: var(--primary); }
.menu-arrow { font-size: 32rpx; color: var(--text-light); }

.footer {
  text-align: center;
  padding: 60rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}
.footer-sub { display: block; margin-top: 8rpx; }
