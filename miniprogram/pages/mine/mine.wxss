.page-title { font-size: 40rpx; font-weight: 700; margin-bottom: 36rpx; color: var(--gold); }
.menu-list { margin-bottom: 48rpx; }
.menu-item {
  display: flex; align-items: center;
  margin-bottom: 12rpx; padding: 28rpx 32rpx;
  font-size: 28rpx; border: 1rpx solid var(--glass-border);
  background: var(--bg-card);
}
.share-item {
  border: 1rpx solid var(--glass-border); text-align: left;
  width: 100%; box-sizing: border-box; background: var(--bg-card);
}
.menu-icon { width: 38rpx; height: 38rpx; margin-right: 18rpx; }
.menu-label { flex: 1; font-weight: 500; color: var(--text); }
.menu-value { font-size: 26rpx; color: var(--gold); }
.menu-arrow { font-size: 32rpx; color: var(--text-light); }

.footer { text-align: center; padding: 60rpx 0; font-size: 24rpx; color: var(--text-light); line-height: 1.8; }
.footer-sub { display: block; }
