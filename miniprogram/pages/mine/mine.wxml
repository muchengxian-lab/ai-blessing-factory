<view class="page-container">
  <view class="page-title">我的</view>

  <view class="menu-list">
    <view class="menu-item card" bindtap="onToggleRemind">
      <image class="menu-icon" src="/images/icons/menu-reminder.svg"></image>
      <text class="menu-label">节日提醒</text>
      <text class="menu-value">{{remindEnabled ? '已开启' : '已关闭'}}</text>
    </view>

    <view class="menu-item card" bindtap="onAbout">
      <image class="menu-icon" src="/images/icons/menu-info.svg"></image>
      <text class="menu-label">关于心祝-祝福语</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item card" bindtap="onFeedback">
      <image class="menu-icon" src="/images/icons/menu-feedback.svg"></image>
      <text class="menu-label">反馈与建议</text>
      <text class="menu-arrow">›</text>
    </view>

    <button class="menu-item card share-item" open-type="share">
      <image class="menu-icon" src="/images/icons/action-share.svg"></image>
      <text class="menu-label">推荐给朋友</text>
      <text class="menu-arrow">›</text>
    </button>
  </view>

  <view class="footer">
    <text>心祝-祝福语 v1.0</text>
    <text class="footer-sub">AI生成，仅供参考 · 祝福由心</text>
  </view>

  <tab-bar current="{{2}}" />
</view>
