.style-grid { display: flex; flex-wrap: wrap; margin: -8rpx; }
.style-grid .style-item { margin: 8rpx; }
.style-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(33.33% - 12rpx);
  height: 140rpx;
  border-radius: var(--radius);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  padding: 16rpx 8rpx;
}
.style-emoji { font-size: 32rpx; margin-bottom: 4rpx; }
.style-name { font-size: 26rpx; font-weight: 500; margin-bottom: 2rpx; }
.style-desc { font-size: 20rpx; color: var(--text-light); }
.style-active {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(255,107,53,0.08), rgba(255,140,90,0.04));
}
.style-active .style-name { color: var(--primary); }
