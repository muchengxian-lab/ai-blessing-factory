.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--border-light);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 32rpx;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 2rpx;
}
.tab-text {
  font-size: 20rpx;
  color: var(--text-light);
  font-weight: 400;
}
.tab-item.active .tab-text {
  color: var(--rose);
  font-weight: 600;
}
