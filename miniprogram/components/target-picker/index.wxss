.target-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}
.target-grid .target-item { margin: 6rpx; }
.target-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(33.33% - 12rpx);
  height: 128rpx;
  border-radius: var(--radius);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}
.target-emoji { font-size: 36rpx; margin-bottom: 6rpx; }
.target-name { font-size: 24rpx; color: var(--text-light); font-weight: 500; }
.target-active {
  border-color: var(--rose);
  background: var(--rose-soft);
}
.target-active .target-name { color: var(--rose); font-weight: 600; }
