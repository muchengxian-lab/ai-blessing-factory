.target-grid { display: flex; flex-wrap: wrap; margin: -8rpx; }
.target-grid .target-item { margin: 8rpx; }
.target-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(33.33% - 12rpx);
  height: 120rpx;
  border-radius: var(--radius);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
}
.target-emoji { font-size: 36rpx; margin-bottom: 4rpx; }
.target-name { font-size: 24rpx; color: var(--text-light); }
.target-active {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(255,107,53,0.08), rgba(255,140,90,0.04));
}
.target-active .target-name { color: var(--primary); font-weight: 600; }
