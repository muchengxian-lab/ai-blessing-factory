.empty-wrap {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 120rpx 60rpx;
}
.empty-icon { width: 88rpx; height: 88rpx; margin-bottom: 24rpx; opacity: 0.65; }
.empty-text {
  font-size: 28rpx; color: var(--text-light); text-align: center;
  white-space: pre-wrap; line-height: 1.8; margin-bottom: 44rpx;
}
.empty-btn { width: 260rpx; height: 84rpx; font-size: 28rpx; }
