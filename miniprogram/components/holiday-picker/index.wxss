.picker-scroll { white-space: nowrap; }
.picker-row { display: flex; padding: 8rpx 0; }
.picker-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  min-width: 144rpx;
  height: 128rpx;
  margin-right: 16rpx;
  border-radius: var(--radius);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}
.picker-emoji { font-size: 40rpx; margin-bottom: 6rpx; }
.picker-name { font-size: 24rpx; color: var(--text-light); font-weight: 500; }
.picker-active {
  border-color: var(--rose);
  background: var(--rose-soft);
}
.picker-active .picker-name { color: var(--rose); font-weight: 600; }
