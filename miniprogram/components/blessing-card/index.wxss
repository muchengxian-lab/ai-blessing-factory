.blessing-card { margin-bottom: 0; }
.blessing-text {
  font-size: 34rpx; line-height: 2; white-space: pre-wrap;
  min-height: 200rpx; color: var(--text); letter-spacing: 1rpx;
}
.blessing-nav {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 28rpx; padding-top: 24rpx;
  border-top: 1rpx solid var(--glass-border);
}
.nav-btn {
  font-size: 26rpx; color: var(--gold);
  padding: 10rpx 20rpx; border-radius: 24rpx;
  background: rgba(240,192,96,0.12);
}
.nav-disabled { color: var(--text-light); background: transparent; }
.nav-indicator { font-size: 24rpx; color: var(--text-light); }
