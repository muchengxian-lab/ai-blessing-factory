.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}
.loading-dot {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--rose);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 22rpx; font-size: 26rpx; color: var(--text-light); }
