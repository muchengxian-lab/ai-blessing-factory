/* ===== AI祝福工厂 — 精装贺卡风 ===== */
page {
  --rose: #CD5C5C;
  --rose-light: #E08080;
  --rose-soft: #FDF0F0;
  --gold: #C8963E;
  --gold-light: #E0C878;
  --gold-soft: #FDF8EE;
  --bg: #FFFBF8;
  --bg-card: #FFFFFF;
  --text: #3D2C2A;
  --text-light: #A89B95;
  --text-mid: #7A6A65;
  --border: #F0E8E2;
  --border-light: #F8F2EC;
  --shadow-sm: 0 1rpx 6rpx rgba(61,44,42,0.04);
  --shadow: 0 4rpx 16rpx rgba(61,44,42,0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(61,44,42,0.08);
  --radius-sm: 10rpx;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--text);
  background: var(--bg);
  font-size: 28rpx;
  line-height: 1.7;
}

/* ===== 通用组件 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, var(--rose), var(--rose-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 24rpx rgba(205,92,92,0.25);
  transition: all 0.2s;
}
.btn-primary[disabled] {
  background: #E8E0DD;
  color: #C4B8B2;
  box-shadow: none;
}
.btn-primary:active { transform: scale(0.98); }

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--radius);
  background: var(--bg-card);
  border: 2rpx solid var(--rose);
  color: var(--rose);
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 32rpx;
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  border: 1rpx solid var(--border-light);
}

.page-container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* ===== 滚动条 ===== */
::-webkit-scrollbar { width: 0; height: 0; }
